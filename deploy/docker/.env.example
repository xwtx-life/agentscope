# LAN address of the Ubuntu host. No DNS or domain is required.
LAN_HOST=192.168.1.100
AGENTSCOPE_CORS_ORIGINS=http://192.168.1.100:18080,http://localhost:18080,http://127.0.0.1:18080
GATEWAY_HTTP_PORT=18080
SKILLHUB_HTTP_PORT=18081

# Generate both values before first startup. Do not commit the resulting .env.
AGENTSCOPE_ENV=development
AGENTSCOPE_JWT_SECRET=replace-with-at-least-32-random-characters
AGENTSCOPE_SECRET_ENCRYPTION_KEY=replace-with-url-safe-base64-for-32-bytes
AGENTSCOPE_SECURE_COOKIES=false

# AgentScope images and dependencies.
AGENTSCOPE_API_IMAGE=local/agentscope-api:current
AGENTSCOPE_WEB_IMAGE=local/agentscope-web:current
AGENTSCOPE_REDIS_IMAGE=redis:7-alpine
QDRANT_IMAGE=qdrant/qdrant:v1.14.1
AGENTSCOPE_REDIS_DB=0
AGENTSCOPE_REDIS_PASSWORD=
# Off by default — Playwright/npx MCP fails in most Docker hosts.
AGENTSCOPE_ENABLE_MCP=0
AMAP_API_KEY=
CLAWHUB_API_TOKEN=
AGENTSCOPE_SKILLHUB_URL=http://skillhub-server:8080

# SkillHub release images and application settings.
SKILLHUB_VERSION=v0.2.14
SKILLHUB_SERVER_IMAGE=ghcr.io/iflytek/skillhub-server:v0.2.14
SKILLHUB_WEB_IMAGE=ghcr.io/iflytek/skillhub-web:v0.2.14
SKILLHUB_SCANNER_IMAGE=ghcr.io/iflytek/skillhub-scanner:v0.2.14
SKILLHUB_POSTGRES_IMAGE=postgres:16-alpine
SKILLHUB_REDIS_IMAGE=redis:7-alpine
SKILLHUB_POSTGRES_DB=skillhub
SKILLHUB_POSTGRES_USER=skillhub
SKILLHUB_POSTGRES_PASSWORD=replace-with-a-strong-postgres-password
SKILLHUB_PUBLIC_BASE_URL=http://192.168.1.100:18081
SKILLHUB_DOWNLOAD_ANON_COOKIE_SECRET=replace-with-a-long-random-secret
SKILLHUB_SESSION_COOKIE_SECURE=false
SKILLHUB_SECURITY_SCANNER_ENABLED=true
SKILL_SCANNER_LLM_API_KEY=
SKILL_SCANNER_LLM_BASE_URL=
SKILL_SCANNER_LLM_MODEL=
BOOTSTRAP_ADMIN_ENABLED=true
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-strong-skillhub-admin-password
BOOTSTRAP_ADMIN_EMAIL=admin@skillhub.local
BOOTSTRAP_ADMIN_DISPLAY_NAME=Admin
BOOTSTRAP_ADMIN_USER_ID=docker-admin
