# v0.2 overlay — copy to .env.v02 on the live host.
# Layout: /home/agent/v2/{docker,source,*.tar}  — no nginx gateway.
# up-v02.sh auto-fills LAN_HOST + CORS from the machine IP.

# Leave empty or 192.168.1.100 — up-v02.sh replaces with real IP.
LAN_HOST=

# Direct ports (browser → WEB; setup page server URL → API).
WEB_HTTP_PORT=18082
API_HTTP_PORT=18083

# Overwritten by up-v02.sh to match LAN_HOST + WEB_HTTP_PORT.
AGENTSCOPE_CORS_ORIGINS=

AGENTSCOPE_ENV=development
AGENTSCOPE_JWT_SECRET=replace-with-same-secret-as-v01
AGENTSCOPE_SECRET_ENCRYPTION_KEY=replace-with-same-key-as-v01
AGENTSCOPE_SECURE_COOKIES=false

AGENTSCOPE_API_IMAGE=local/agentscope-api:v0.2
AGENTSCOPE_WEB_IMAGE=local/agentscope-web:v0.2

# MUST be ../source when scripts live in /home/agent/v2/docker
AGENTSCOPE_HOST_ROOT=../source

AGENTSCOPE_REDIS_DB=0
AGENTSCOPE_REDIS_PASSWORD=
AGENTSCOPE_MESSAGE_BUS=redis
# Off by default — Playwright/npx MCP fails in most Docker hosts.
AGENTSCOPE_ENABLE_MCP=0
AMAP_API_KEY=
CLAWHUB_API_TOKEN=
AGENTSCOPE_SKILLHUB_URL=http://skillhub-server:8080
AGENTSCOPE_SKILLHUB_TOKEN=

V01_DOCKER_NETWORK=agentscope-stack_default
V01_VOLUME_WORKSPACES=agentscope-stack_agentscope_workspaces
V01_VOLUME_BLOBS=agentscope-stack_agentscope_blobs
V01_VOLUME_SKILL_SUBMISSIONS=agentscope-stack_agentscope_skill_submissions
